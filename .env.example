# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
EMAIL=your@email.com
PASSWORD=yourpassword

# ── Optional ──────────────────────────────────────────────────────────────────
# Port for the API + dashboard server (default: 25515)
PORT=25515

# PostgreSQL connection string (only needed if using the DB features)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
